{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "baseUrl": "./",
    "outDir": "out",
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@polkadot/types/lookup": [
        "node_modules/@unique-nft/opal-testnet-types/types-lookup"
      ]
    }
  }
}
